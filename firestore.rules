rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Public get so storefront can show seller/shop name
      allow get: if true;
      allow list: if false;
      allow write: if isOwner(userId);
    }

    // Legacy collection
    match /shopKeepers/{userId} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner(userId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.shopKeeperId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.shopKeeperId == request.auth.uid
        || (
          // Customer placing order: stock decreases by 1 only
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["stock", "updatedAt"])
          && request.resource.data.stock == resource.data.stock - 1
          && request.resource.data.stock >= 0
        )
      );
      allow delete: if signedIn()
        && resource.data.shopKeeperId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "on_the_way";
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.shopKeeperId == request.auth.uid
      );
      allow update: if signedIn()
        && resource.data.shopKeeperId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "completed";
      allow delete: if false;
    }
  }
}
